# --- Project Specifics ---
# Исключаем все данные, так как они могут быть тяжелыми или конфиденциальными
# Основано на вашей структуре: "data/ # Хранение данных (исключено из git)"
data/*
!data/**/
!data/**/.gitkeep
# Local source-audit observations are not versioned research data.
/data/audit/
/data/analysis/

# Если вы храните API ключи в settings.py, лучше исключить его и оставить settings.template.py
configs/settings.py

# --- Python ---
# Байт-код и кэши
__pycache__/
*.pyc
*.pyo
*.pyd

# --- PyCharm IDE ---
# Настройки редактора, которые не нужны в репозитории
.idea/

# --- Jupyter Notebooks ---
# Чекпоинты ноутбуков (автосохранения)
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# --- Virtual Environments ---
# Локальные виртуальные окружения
venv/
env/
.venv/
.venv-app/
.env

# --- OS System Files ---
# Системные файлы macOS и Windows
.DS_Store
Thumbs.db
ehthumbs.db

# --- Logs & Databases ---
*.log
*.sqlite
*.db

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/

# --- Custom / Debug ---
cache/
.iduedu_cache/
*.txt
!requirements.txt
!requirements-benchmark.txt
/benchmarks/osm_rust/target/

# --- Локальная документация и планы (не для репозитория) ---
docs/*
